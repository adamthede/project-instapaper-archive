# Instapaper API Configuration
# Get API credentials from: https://www.instapaper.com/main/request_oauth_consumer_token
INSTAPAPER_CONSUMER_KEY=your_consumer_key_here
INSTAPAPER_CONSUMER_SECRET=your_consumer_secret_here
INSTAPAPER_USERNAME=your_email@example.com
INSTAPAPER_PASSWORD=your_password_here
INSTAPAPER_FOLDER=archive

# Vault Path - Where markdown files are stored/enriched
# Default: ~/Obsidian/Vault/Instapaper
INSTAPAPER_VAULT_PATH=/path/to/your/markdown/vault

# Legacy Import Paths (for import_legacy_archive.py)
# Source: Where your PDF/Word/TXT/RTF files are located
# Output: Where converted markdown files should be saved
IMPORT_SOURCE_PATH=/path/to/your/legacy/articles
IMPORT_OUTPUT_PATH=/path/to/markdown/output

# Google Gemini API (for fast enrichment)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

