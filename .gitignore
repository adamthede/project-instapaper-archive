.legacy_import_manifest.json
.instapaper_manifest.json

# Data files / Output files
*.csv
api_responses/
premium_api_results/
date_range_results/
# `data/*` rather than `data/`: git does not descend into an ignored DIRECTORY,
# so a negation inside one never fires. Ignoring the CONTENTS leaves the door
# open for the one thing below that has to be version-controlled.
data/*
# The curated taxonomy is the source of truth from Phase B onward, and the plan
# calls for it to be human-readable, diffable and editable. None of that is
# possible while it sits under an ignore rule.
!data/taxonomy/
# ...but only the YAML in it. Un-ignoring the whole directory would silently
# start tracking any large derived file a later phase happens to write there.
data/taxonomy/*
!data/taxonomy/*.yaml
scripts/data/
**/archive_index.parquet
**/review_history.parquet

# Wrangler's local build cache. Regenerated on every deploy; it has been
# showing up as untracked noise in every `git status` since the site went live.
.wrangler/

# Rendered mockups. The GENERATORS are tracked (site/mockup_*.py) because the
# next design question needs them; their 732KB of output is not source.
docs/mockups/

# Local chat/export artifacts
chats/cursor_expanding_article_archive_analys.md

